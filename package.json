{
  "name": "dhcpulse",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first DHCP configuration analysis and guarded change planning for administrators.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifrost0x/dhcpulse.git"
  },
  "bugs": {
    "url": "https://github.com/bifrost0x/dhcpulse/issues"
  },
  "homepage": "https://github.com/bifrost0x/dhcpulse#readme",
  "keywords": [
    "dhcp",
    "microsoft-dhcp",
    "network-administration",
    "network-security",
    "ipam"
  ],
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "audit:dependencies": "npm audit --audit-level=low",
    "check:repo": "node scripts/verify-repository.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173 --clearScreen false",
    "start": "npm run build && npm run preview",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --clearScreen false",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
